{
  "name": "use-audio-recording",
  "version": "2.0.0",
  "description": "A professional React hook for audio recording with TypeScript support",
  "license": "MIT",
  "author": {
    "name": "Dmitrii Selikhov",
    "email": "dmitrii.selikhov@gmail.com",
    "url": "https://www.linkedin.com/in/dimetrix"
  },
  "contributors": [
    {
      "name": "Dmitrii Selikhov",
      "email": "dmitrii.selikhov@gmail.com",
      "url": "https://www.linkedin.com/in/dimetrix"
    }
  ],
  "email": "dmitrii.selikhov@gmail.com",
  "scripts": {
    "build": "tsup ./src",
    "watch": "tsup ./src --watch",
    "run": "node dist/index.js",
    "dev": "pnpm run watch & nodemon dist/index.js",
    "prettier": "prettier --write src/**",
    "format": "pnpm run prettier && pnpm type",
    "bootstrap": "pnpm install && pnpm format",
    "type": "tsc --noEmit --incremental",
    "tsc:clean": "tsc --build --clean",
    "prepare": "husky",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "homepage": "https://github.com/idimetrix/use-audio-recording#readme",
  "url": "https://github.com/idimetrix/use-audio-recording/issue",
  "bugs": {
    "url": "https://github.com/idimetrix/use-audio-recording/issues"
  },
  "keywords": [
    "react",
    "audio",
    "recording",
    "microphone",
    "media",
    "webapi",
    "typescript",
    "hook",
    "react-hook"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "dependencies": {
    "react": "19.1.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/jest": "30.0.0",
    "@types/node": "24.5.2",
    "@types/react": "19.1.13",
    "husky": "9.1.7",
    "jest": "30.1.3",
    "jest-environment-jsdom": "30.1.2",
    "lint-staged": "16.2.0",
    "nodemon": "3.1.10",
    "prettier": "3.6.2",
    "react-dom": "19.1.1",
    "ts-jest": "29.4.4",
    "ts-node": "10.9.2",
    "tsup": "8.5.0",
    "typescript": "5.9.2"
  }
}
